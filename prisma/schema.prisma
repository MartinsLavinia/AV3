generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ================================
// ENUMS
// ================================

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum TipoRelatorioAnalitico {
  EFICIENCIA_OPERACIONAL
  VALOR_RECUPERACAO
  VIDA_UTIL_REMANESCENTE
}

enum EscopoChaveApi {
  RASTREAMENTO_LEITURA
  LOTES_CRIACAO
  RELATORIOS_LEITURA
}

// ================================
// ORGANIZACAO
// ================================

model Organizacao {
  id                String   @id @default(uuid()) @db.Uuid
  razaoSocial       String
  cnpj              String   @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime @default(now())
  ativo             Boolean  @default(true)
  versao            Int      @default(1)

  contrato    Contrato?
  lotes       Lote[]
  chavesApi   ChaveApiParceiro[]
  tarefasAnaliticas TarefaAnalitica[]
}

// Credencial de integração externa. O segredo em texto puro nunca é persistido.
model ChaveApiParceiro {
  id                  String          @id @default(uuid()) @db.Uuid
  organizacaoId       String          @db.Uuid
  nome                String
  prefixo             String
  segredoHash         String          @unique
  permissoes          EscopoChaveApi[] @default([])
  criadaPor           String
  criadaEm            DateTime        @default(now())
  expiraEm            DateTime
  ultimaUtilizacaoEm  DateTime?
  revogadaEm          DateTime?
  revogadaPor         String?
  motivoRevogacao     String?

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tarefasAnaliticas TarefaAnalitica[]

  @@index([organizacaoId, criadaEm])
  @@index([organizacaoId, revogadaEm, expiraEm])
}

// ================================
// CONTRATO
// ================================

model Contrato {
  id                  String   @id @default(uuid()) @db.Uuid
  organizacaoId       String   @unique @db.Uuid
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           String[]
  valorMensal         Decimal  @db.Decimal(10, 2)
  renovacaoAutomatica Boolean  @default(false)
  versao              Int      @default(1)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

// ================================
// LOTE
// ================================

model Lote {
  id                  String     @id @default(uuid()) @db.Uuid
  dataEntrada         DateTime   @default(now())
  organizacaoId       String     @db.Uuid
  notaFiscal          String
  transportadora      String
  statusProcessamento StatusLote @default(RECEBIDO)
  observacoes         String
  versao              Int        @default(1)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  equipamentos Equipamento[]
}

// ================================
// EQUIPAMENTO
// ================================

model Equipamento {
  id                  String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Float
  loteId              String             @db.Uuid
  posicaoNoLote       Int
  statusRastreamento  StatusRastreamento @default(AGUARDANDO_TRIAGEM)
  versao              Int                @default(1)

  lote Lote @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  movimentacoes           Movimentacao[]
  eventosTriagem          TriagemEvento[]
  historicoEstadosFisicos HistoricoEstadoFisico[]

  @@unique([loteId, posicaoNoLote])
}

// Histórico append-only das etapas de triagem para métricas operacionais.
model TriagemEvento {
  id            String            @id @default(uuid()) @db.Uuid
  equipamentoId String            @db.Uuid
  tipo          TipoEventoTriagem
  dataHora      DateTime          @default(now())
  responsavel   String

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipamentoId, dataHora])
  @@index([tipo, dataHora])
  @@index([responsavel, dataHora])
}

enum TipoEventoTriagem {
  INICIADA
  CONCLUIDA
}

// Registro histórico imutável de mudanças na condição física do equipamento.
model HistoricoEstadoFisico {
  id             String       @id @default(uuid()) @db.Uuid
  equipamentoId  String       @db.Uuid
  estadoAnterior EstadoFisico
  estadoNovo     EstadoFisico
  dataHora       DateTime     @default(now())
  responsavel    String
  justificativa  String       @default("")

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipamentoId, dataHora])
  @@index([estadoNovo, dataHora])
  @@index([responsavel, dataHora])
}

// Catálogo versionável de estimativas; valores devem ter fonte explicitada.
model ReferenciaRecuperacao {
  id                 String          @id @default(uuid()) @db.Uuid
  grupoId            String          @db.Uuid
  assinaturaCriterio String
  tipo               TipoEquipamento
  estadoFisico       EstadoFisico
  marca              String?
  modelo             String?
  valorEstimado      Decimal         @db.Decimal(12, 2)
  moeda              String          @default("BRL")
  fonte              String
  justificativa      String
  vigenteDesde       DateTime        @default(now())
  vigenteAte         DateTime?
  ativa              Boolean         @default(true)
  versao             Int             @default(1)
  criadaEm           DateTime        @default(now())
  atualizadaEm       DateTime        @updatedAt
  criadaPor          String?
  encerradaPor       String?
  motivoEncerramento String?

  @@unique([grupoId, versao])
  @@index([assinaturaCriterio, versao])
  @@index([tipo, estadoFisico, ativa])
  @@index([marca, modelo, ativa])
  @@index([vigenteDesde, vigenteAte])
}

// Resultado persistido de uma execução analítica concluída.
model ExecucaoAnalitica {
  id                 String                 @id @default(uuid()) @db.Uuid
  tipo               TipoRelatorioAnalitico
  geradoEm           DateTime               @default(now())
  periodoInicio      DateTime?
  periodoFim         DateTime?
  quantidadeAmostras Int                    @default(0)
  versaoAlgoritmo    String
  parametros         Json?
  resultado          Json
  referenciasUsadas  Json?
  solicitadoPor      String?
  tarefaId           String?                @unique @db.Uuid

  tarefa TarefaAnalitica? @relation(fields: [tarefaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tipo, geradoEm])
  @@index([periodoInicio, periodoFim])
}

enum StatusTarefaAnalitica {
  AGUARDANDO
  PROCESSANDO
  CONCLUIDA
  FALHA
}

// Ciclo de vida de solicitações analíticas recebidas pela API e processadas via BullMQ.
model TarefaAnalitica {
  id                  String                @id @default(uuid()) @db.Uuid
  organizacaoId       String                @db.Uuid
  chaveApiId          String                @db.Uuid
  tipo                TipoRelatorioAnalitico
  status              StatusTarefaAnalitica @default(AGUARDANDO)
  chaveIdempotencia   String
  hashRequisicao      String
  parametros          Json?
  tentativas          Int                   @default(0)
  erro                String?
  criadaEm            DateTime              @default(now())
  iniciadaEm          DateTime?
  concluidaEm         DateTime?

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chaveApi ChaveApiParceiro @relation(fields: [chaveApiId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  execucao ExecucaoAnalitica?

  @@unique([organizacaoId, chaveIdempotencia])
  @@index([organizacaoId, criadaEm])
  @@index([status, criadaEm])
}

// ================================
// MOVIMENTACAO
// ================================

model Movimentacao {
  id            String   @id @default(uuid()) @db.Uuid
  equipamentoId String   @db.Uuid
  dataHora      DateTime @default(now())
  origem        String
  destino       String
  responsavel   String
  observacao    String
  versao        Int      @default(1)

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipamentoId, dataHora])
}

model Usuario {
  id                   String       @id @default(uuid()) @db.Uuid
  nomeCompleto         String
  email                String       @unique
  senhaHash            String
  papel                PapelUsuario
  ativo                Boolean      @default(true)
  administradorInicial Boolean      @default(false)
  dataCadastro         DateTime     @default(now())
  versao               Int          @default(1)
}

// Registro singleton para os parâmetros globais do sistema (id fixo = 1).
model ConfiguracaoSistema {
  id                          Int      @id @default(1)
  aliquotaImposto             Float    @default(0)
  coeficienteDepreciacaoAnual Float    @default(0.1)
  atualizadoEm                DateTime @updatedAt
}
