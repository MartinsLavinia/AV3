DATABASE_URL="postgresql://usuario:senha@localhost:5432/AV3?schema=public"
JWT_SECRET="substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Usadas pelo Docker Compose em ambiente local; não reutilize estas credenciais em produção.
POSTGRES_USER=greencode
POSTGRES_PASSWORD=greencode_dev_only
POSTGRES_DB=AV3
REDIS_URL=redis://localhost:6380
ANALYTICS_WORKER_CONCURRENCY=2

# Permite executar o seed de demonstração (somente em banco de desenvolvimento)
SEED_DEMO_DATA=false

# O teste de jornada cria e apaga um schema aleatório dentro deste PostgreSQL.
# Use somente uma instância local de desenvolvimento/teste, nunca produção.
JOURNEY_DATABASE_URL="postgresql://usuario:senha@localhost:5432/AV3TESTES?schema=public"
